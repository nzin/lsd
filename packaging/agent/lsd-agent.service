[Unit]
Description=Linux Simple Diagnostic agent (host metrics and eBPF flows)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lsd
Group=lsd
# Defaults; override anything in /etc/lsd/agent.env (LSD_SERVER, LSD_TOKEN, LSD_INTERVAL, ...)
Environment=LSD_STATE_DIR=/var/lib/lsd-agent
EnvironmentFile=-/etc/lsd/agent.env
ExecStart=/opt/lsd/agent/lsd agent
Restart=always
RestartSec=5
# /var/lib/lsd-agent holds the generated node id
StateDirectory=lsd-agent
StateDirectoryMode=0750

# Not root: only the capabilities needed to load and attach the eBPF flow program.
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
LimitMEMLOCK=infinity

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
