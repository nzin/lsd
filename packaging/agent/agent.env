# lsd agent configuration (read by systemd; restart to apply:
#   sudo systemctl restart lsd-agent)
#
# Every `lsd agent` flag can be set here as LSD_<NAME>.

# The server's gRPC address -- set this to your server
LSD_SERVER=localhost:7070
# Shared secret, if the server was started with LSD_TOKEN
#LSD_TOKEN=
# Name shown in the UI (default: the machine's hostname)
#LSD_HOSTNAME_OVERRIDE=
# Collection interval
#LSD_INTERVAL=5s
# Turn eBPF flow capture off (host metrics keep working)
#LSD_NO_FLOWS=true
# Only capture flows on these interfaces (comma-separated globs; default: all physical)
#LSD_FLOW_IFACES=eth0
# Talk TLS to the server
#LSD_TLS=true
#LSD_TLS_SKIP_VERIFY=false
# More verbose logs: debug | info | warn | error
#LSD_LOG_LEVEL=info
