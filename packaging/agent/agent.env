# simplemonitor agent configuration (read by systemd; restart to apply:
#   sudo systemctl restart simplemonitor-agent)
#
# Every `simplemonitor agent` flag can be set here as SM_<NAME>.

# The server's gRPC address -- set this to your server
SM_SERVER=localhost:7070
# Shared secret, if the server was started with SM_TOKEN
#SM_TOKEN=
# Name shown in the UI (default: the machine's hostname)
#SM_HOSTNAME_OVERRIDE=
# Collection interval
#SM_INTERVAL=5s
# Turn eBPF flow capture off (host metrics keep working)
#SM_NO_FLOWS=true
# Only capture flows on these interfaces (comma-separated globs; default: all physical)
#SM_FLOW_IFACES=eth0
# Talk TLS to the server
#SM_TLS=true
#SM_TLS_SKIP_VERIFY=false
# More verbose logs: debug | info | warn | error
#SM_LOG_LEVEL=info
