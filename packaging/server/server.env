# lsd server configuration (read by systemd; restart to apply:
#   sudo systemctl restart lsd-server)
#
# Every `lsd server` flag can be set here as LSD_<NAME>.

# Web UI + API
#LSD_HTTP_ADDR=:8080
# gRPC ingest (agents connect here)
#LSD_GRPC_ADDR=:7070
# How long metrics are kept
#LSD_RETENTION=720h
# Require this shared secret from agents (the same value goes in the agents' LSD_TOKEN)
#LSD_TOKEN=
# TLS for the gRPC port
#LSD_TLS_CERT=
#LSD_TLS_KEY=
# More verbose logs: debug | info | warn | error
#LSD_LOG_LEVEL=info
