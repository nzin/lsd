# simplemonitor server configuration (read by systemd; restart to apply:
#   sudo systemctl restart simplemonitor-server)
#
# Every `simplemonitor server` flag can be set here as SM_<NAME>.

# Web UI + API
#SM_HTTP_ADDR=:8080
# gRPC ingest (agents connect here)
#SM_GRPC_ADDR=:7070
# How long metrics are kept
#SM_RETENTION=720h
# Require this shared secret from agents (the same value goes in the agents' SM_TOKEN)
#SM_TOKEN=
# TLS for the gRPC port
#SM_TLS_CERT=
#SM_TLS_KEY=
# More verbose logs: debug | info | warn | error
#SM_LOG_LEVEL=info
