#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd lsd >/dev/null 2>&1; then
        adduser --system --group --no-create-home --home /opt/lsd \
            --shell /usr/sbin/nologin --gecos "Linux Simple Diagnostic" lsd
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable lsd-server.service >/dev/null 2>&1 || true
        # also on upgrade: run the new binary
        systemctl restart lsd-server.service \
            || echo "lsd-server: could not start the service, see 'systemctl status lsd-server'" >&2
    fi
fi
exit 0
